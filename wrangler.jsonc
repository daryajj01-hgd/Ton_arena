{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ton-arena",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/ready"
    ],
    "not_found_handling": "single-page-application"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "27aeecbb3dd4495b89cfad12883569c3"
    }
  ]
}
