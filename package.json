{
  "name": "ton-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run build:server && npm test && npm run build:frontend",
    "preview": "vite preview --host 0.0.0.0",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:frontend": "vite build",
    "test": "node --test",
    "db:migrate": "npm run build:server && node dist-server/migrate.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5"
  }
}
